+    uint32_t smr = read (0x800 + 4 * i);
+    if (!(smr & 0x80000000U)) {
+      if (!matches) {
+        p.slot = i;
+      }
+      continue;
+    }
+    uint32_t s2cr = read (0xc00 + 4 * i);
+    uint32_t mask = (smr >> 16) & 0x7fff;
+    bool match = ((smr ^ stream) & 0xffff & ~mask) == 0;
+    bool ourBank = ((s2cr >> 16) & 3) == 0 && (s2cr & 255) == p.bank;
