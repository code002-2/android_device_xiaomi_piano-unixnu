+        }
+        p.bank = firmwareBank;
+        p.slot = i;
+        p.takeover = true;
+        p.reuse = false;
+        continue;
+      }
+      if (matches > 1 || mask || !usable) {
+        p.slot = i; p.smr = smr; p.s2cr = s2cr;
+        p.error = "conflicting UFS stream mapping"; return p;
+      }
+      p.reuse = ourBank; p.slot = i;
+    } else if (ourBank) {
+      p.slot = i; p.smr = smr; p.s2cr = s2cr;
+      p.error = "reserved context bank already used"; return p;
+    }
